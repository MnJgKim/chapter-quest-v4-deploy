{
  "name": "chapter-quest-v4-launch",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node build-assets.mjs && node --test *.test.mjs",
    "build": "node build-assets.mjs && wrangler deploy --config ../wrangler.jsonc --dry-run --outdir .build",
    "dev": "node build-assets.mjs && wrangler dev --config ../wrangler.jsonc",
    "test:local-auth": "python local-supabase/lean/integration_test.py qa-results/local-auth.json",
    "test:local-browser": "python local-supabase/lean/browser_test.py qa-results/local-auth-browser.json"
  },
  "devDependencies": {
    "pdfjs-dist": "3.11.174",
    "supabase": "3.1.0",
    "wrangler": "4.159.0"
  }
}
